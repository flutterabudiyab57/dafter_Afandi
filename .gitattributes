# Normalize text files to LF in the repository.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch line endings or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.ttf binary
*.otf binary
*.jks binary
*.keystore binary
*.sqlite binary
